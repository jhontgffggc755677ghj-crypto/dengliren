# Required in production. Any long random string is fine for local development.
JWT_SECRET=change-me-to-a-long-random-string

# Optional. JWT lifetime passed to jsonwebtoken (default: 7d).
# JWT_EXPIRES_IN=7d

# Optional. API port (default: 3001).
# PORT=3001

# Optional. SQLite file path (default: ./database.db).
# DATABASE_PATH=./database.db
